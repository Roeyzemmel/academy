{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "if": "Edit(*.tex)",
            "command": "py \"${CLAUDE_PLUGIN_ROOT}/scripts/tex_edit_check.py\"",
            "statusMessage": "checking the draft",
            "timeout": 90
          },
          {
            "type": "command",
            "if": "Write(*.tex)",
            "command": "py \"${CLAUDE_PLUGIN_ROOT}/scripts/tex_edit_check.py\"",
            "statusMessage": "checking the draft",
            "timeout": 90
          },
          {
            "type": "command",
            "if": "MultiEdit(*.tex)",
            "command": "py \"${CLAUDE_PLUGIN_ROOT}/scripts/tex_edit_check.py\"",
            "statusMessage": "checking the draft",
            "timeout": 90
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "if": "Edit(*.bib)",
            "command": "py \"${CLAUDE_PLUGIN_ROOT}/scripts/bib_gate.py\"",
            "timeout": 20
          },
          {
            "type": "command",
            "if": "Write(*.bib)",
            "command": "py \"${CLAUDE_PLUGIN_ROOT}/scripts/bib_gate.py\"",
            "timeout": 20
          },
          {
            "type": "command",
            "if": "MultiEdit(*.bib)",
            "command": "py \"${CLAUDE_PLUGIN_ROOT}/scripts/bib_gate.py\"",
            "timeout": 20
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(git commit *)",
            "command": "py \"${CLAUDE_PLUGIN_ROOT}/scripts/commit_gate.py\"",
            "statusMessage": "checking the draft before the commit",
            "timeout": 150
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "py \"${CLAUDE_PLUGIN_ROOT}/scripts/build_gate.py\"",
            "statusMessage": "building the paper",
            "timeout": 300
          }
        ]
      }
    ]
  }
}
