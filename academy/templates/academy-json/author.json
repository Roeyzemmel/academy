{
  "schema": 1,
  "role": "author",
  "instance": "{{instance}}",
  "domains": [
    "{{domain}}"
  ],
  "ns": "{{ns}}",
  "paths": {
    "tex": [
      "main.tex",
      "sections/*.tex"
    ],
    "bib": "references.bib",
    "drafts": "Drafts",
    "agenda": "Drafts/agenda.md",
    "records": "claims",
    "figures": "figures",
    "views": [
      "Drafts/statements.md",
      "claims/INDEX.md",
      "claims/index.html"
    ]
  },
  "registry": {
    "profile": "paper",
    "root": "claims",
    "db": ".claude/academy.sqlite",
    "statusKeeper": "claim-keeper"
  },
  "budget": {
    "itemsPerRun": 3,
    "serial": true,
    "orchestratorModel": "sonnet",
    "maxModel": "fable",
    "ticketDefault": {
      "runs": 1
    }
  },
  "gate": {
    "commit": "normal",
    "build": true,
    "baseline": null,
    "branches": {}
  },
  "author": {
    "main": "main.tex",
    "build": {
      "dir": ".build",
      "cmd": [
        "latexmk",
        "-pdf",
        "main.tex"
      ],
      "lock": ".build/.lock"
    },
    "checker": {
      "script": "${CLAUDE_PLUGIN_ROOT}/scripts/check_paper.py",
      "args": [],
      "strictArgs": [
        "--strict"
      ],
      "statements": "Drafts/statements.md"
    },
    "theorems": {
      "all": [
        "thm",
        "prop",
        "lem",
        "cor",
        "conj",
        "defn",
        "rmk",
        "ex",
        "quest",
        "claim"
      ],
      "provable": [
        "thm",
        "prop",
        "lem",
        "cor",
        "claim"
      ],
      "commentary": [
        "rmk",
        "quest"
      ]
    },
    "statusLevels": [
      {
        "name": "established",
        "env": null,
        "command": null,
        "colour": "black",
        "kind": "established",
        "statuses": [
          "proved"
        ]
      },
      {
        "name": "sketch",
        "env": "sketch",
        "command": "\\Sketch",
        "colour": "blue",
        "kind": "unestablished",
        "statuses": [
          "sketch",
          "proved-modulo"
        ]
      },
      {
        "name": "conjectural",
        "env": "conjectural",
        "command": "\\Conjectural",
        "colour": "red",
        "kind": "unestablished",
        "statuses": [
          "open",
          "conjectured",
          "supported"
        ]
      },
      {
        "name": "meta",
        "env": "meta",
        "command": "\\Meta",
        "colour": "brown",
        "kind": "commentary",
        "statuses": []
      }
    ],
    "noteMacros": {
      "human": [
        "{{noteMacro}}"
      ],
      "coauthors": [],
      "machine": [
        "\\Claude"
      ]
    },
    "crlf": [],
    "writers": [
      "math-writer",
      "math-editor",
      "tex-engineer",
      "figure-maker",
      "note-sweeper"
    ],
    "bibWriters": [
      "librarian"
    ],
    "preamble": {
      "end": "\\begin{document}",
      "policy": "propose",
      "extraFiles": []
    },
    "labels": {
      "prefixes": [
        "thm",
        "lem",
        "prop",
        "cor",
        "defn",
        "eq",
        "sec",
        "fig"
      ],
      "refCommand": "cref"
    },
    "notes": {
      "maxLines": 3
    },
    "figures": {
      "dir": "tikz",
      "include": "\\includestandalone"
    },
    "bib": {
      "acceptedWarnings": []
    },
    "mainResults": {
      "file": "sections/introduction.tex",
      "labels": []
    }
  }
}
