{
  "schema": 1,
  "role": "expert",
  "instance": "{{instance}}",
  "domains": [
    "{{domain}}"
  ],
  "paths": {
    "index": "index.md",
    "cards": "cards",
    "ledgers": "ledgers",
    "reviews": "reviews",
    "hot": "hot.md",
    "cache": [
      "*.pdf",
      "*.txt",
      "*.meta",
      "*.src/**",
      "*_eprint.tar.gz"
    ],
    "views": [
      "hot.md"
    ]
  },
  "registry": {
    "profile": "none",
    "db": ".claude/academy.sqlite"
  },
  "budget": {
    "itemsPerRun": 3,
    "serial": true,
    "orchestratorModel": "sonnet",
    "maxModel": "fable",
    "ticketDefault": {
      "runs": 1
    }
  },
  "gate": {
    "commit": "off",
    "build": false,
    "baseline": null,
    "branches": {}
  },
  "expert": {
    "bibs": [],
    "accessLog": ".academy/access.log",
    "hotSize": 50,
    "web": {
      "clerk": false,
      "librarian": true
    },
    "shards": {}
  }
}
