{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "py \"${CLAUDE_PLUGIN_ROOT}/scripts/experiment_edit_check.py\"",
            "statusMessage": "checking the experiment header",
            "timeout": 90
          },
          {
            "type": "command",
            "command": "py \"${CLAUDE_PLUGIN_ROOT}/scripts/claims_edit_check.py\"",
            "statusMessage": "checking the claim file",
            "timeout": 60
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "py \"${CLAUDE_PLUGIN_ROOT}/scripts/commit_gate.py\"",
            "statusMessage": "checking experiments before the commit",
            "timeout": 90
          }
        ]
      }
    ]
  }
}
