{
 "_about": "The push gate of this repo (academy/scripts/ship.py, 'The push gate'): what CI would run, run by ship.py before a push. ACADEMY_TEST_HERMETIC=1 skips the tests that read a real home of the workspace (their result depends on that home's state, not on this repo).",
 "pushGate": [
  {
   "name": "lint",
   "run": [
    "ruff",
    "check",
    "."
   ],
   "optional": true,
   "timeout": 120
  },
  {
   "name": "academy/tests",
   "run": [
    "{python}",
    "-m",
    "unittest",
    "discover",
    "-s",
    "academy/tests",
    "-t",
    "academy/tests"
   ],
   "timeout": 900,
   "env": {
    "ACADEMY_TEST_HERMETIC": "1"
   }
  },
  {
   "name": "academy/registry/tests",
   "run": [
    "{python}",
    "-m",
    "unittest",
    "discover",
    "-s",
    "academy/registry/tests",
    "-t",
    "academy/registry/tests"
   ],
   "timeout": 900,
   "env": {
    "ACADEMY_TEST_HERMETIC": "1"
   }
  },
  {
   "name": "expert/tests",
   "run": [
    "{python}",
    "-m",
    "unittest",
    "discover",
    "-s",
    "expert/tests",
    "-t",
    "expert/tests"
   ],
   "timeout": 900,
   "env": {
    "ACADEMY_TEST_HERMETIC": "1"
   }
  },
  {
   "name": "researcher/tests",
   "run": [
    "{python}",
    "-m",
    "unittest",
    "discover",
    "-s",
    "researcher/tests",
    "-t",
    "researcher/tests"
   ],
   "timeout": 900,
   "env": {
    "ACADEMY_TEST_HERMETIC": "1"
   }
  },
  {
   "name": "scientist/tests",
   "run": [
    "{python}",
    "-m",
    "unittest",
    "discover",
    "-s",
    "scientist/tests",
    "-t",
    "scientist/tests"
   ],
   "timeout": 900,
   "env": {
    "ACADEMY_TEST_HERMETIC": "1"
   }
  },
  {
   "name": "author/tests",
   "run": [
    "{python}",
    "-m",
    "unittest",
    "discover",
    "-s",
    "author/tests",
    "-t",
    "author/tests"
   ],
   "timeout": 900,
   "env": {
    "ACADEMY_TEST_HERMETIC": "1"
   }
  },
  {
   "name": "domains/translation-surfaces/tests",
   "run": [
    "{python}",
    "-m",
    "unittest",
    "discover",
    "-s",
    "domains/translation-surfaces/tests",
    "-t",
    "domains/translation-surfaces/tests"
   ],
   "timeout": 900,
   "env": {
    "ACADEMY_TEST_HERMETIC": "1"
   }
  }
 ]
}
