{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "py \"${CLAUDE_PLUGIN_ROOT}/scripts/session_start.py\"",
            "statusMessage": "academy: reading the board",
            "timeout": 60
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "mcp__.*academy.*",
        "hooks": [
          {
            "type": "command",
            "command": "py \"${CLAUDE_PLUGIN_ROOT}/scripts/mcp_write_gate.py\"",
            "statusMessage": "academy: checking tool permissions",
            "timeout": 30
          }
        ]
      },
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "py \"${CLAUDE_PLUGIN_ROOT}/scripts/explainer_write_guard.py\"",
            "statusMessage": "academy: checking the explainer's write",
            "timeout": 20
          }
        ]
      },
      {
        "matcher": "Edit|Write|MultiEdit|Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "py \"${CLAUDE_PLUGIN_ROOT}/scripts/generated_view_guard.py\"",
            "statusMessage": "academy: checking for a generated view",
            "timeout": 30
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "py \"${CLAUDE_PLUGIN_ROOT}/scripts/ticket_edit_check.py\"",
            "statusMessage": "academy: checking the board file",
            "timeout": 60
          }
        ]
      }
    ]
  }
}
